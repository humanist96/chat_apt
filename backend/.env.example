# Chat APT Environment Configuration
# Copy this file to .env and fill in your values

# App
DEBUG=false

# Database (Supabase)
DATABASE_URL=postgresql://user:password@host:5432/database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Redis (Upstash) - REST API (recommended for serverless)
# Get your keys from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Redis - Standard (alternative, for traditional deployments)
REDIS_URL=redis://default:password@host:6379

# 국토교통부 공공데이터 API (실거래가)
# Get your key from: https://www.data.go.kr/data/15057511/openapi.do
PUBLIC_DATA_API_KEY=your-api-key

# Payment (TossPayments)
# Get your keys from: https://developers.tosspayments.com
TOSS_CLIENT_KEY=test_ck_xxx
TOSS_SECRET_KEY=test_sk_xxx

# OpenSearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# Crawler (optional - comma-separated proxy URLs)
PROXY_LIST=

# Telegram Notifications
# Create a bot via @BotFather and get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Error Tracking (Sentry)
# Get your DSN from: https://sentry.io
SENTRY_DSN=
